# Mercado Pago (servidor, NUNCA con NEXT_PUBLIC_)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Mercado Pago (navegador, esta sí puede ser pública)
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Estado del garage y ajustes (servidor). Vercel las crea solo al conectar
# Upstash Redis desde Storage / Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Base de datos de reservas (servidor) — Supabase en la fase 3
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Panel de administración (servidor)
# ADMIN_PASSWORD: mínimo 12 caracteres (obligatoria).
# ADMIN_SESSION_SECRET: opcional; si falta se deriva de la contraseña + token de Upstash.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
